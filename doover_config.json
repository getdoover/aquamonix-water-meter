{
    "aquamonix_water_meter": {
        "name": "aquamonix_water_meter",
        "id": "144018616692557326",
        "display_name": "Aquamonix Water Meter",
        "icon_url": "https://media.licdn.com/dms/image/v2/C4E0BAQHU_nWxuTSpew/company-logo_200_200/company-logo_200_200/0/1651729795726/aquamonix_logo?e=2147483647&v=beta&t=6PRDpYRMxUqtU76QaOgRd5v1JoEN2Wj1Pss-2h8dWdo",
        "banner_url": "https://aquamonix.com.au/wp-content/uploads/2025/07/Aquamonix_Emflux_Logo_Inline_rgb_600px.png",
        "description": "Aquamonix Water Meter application for monitoring water flow and throughput.",
        "long_description": "README.md",
        "type": "DEV",
        "visibility": "PUB",
        "allow_many": true,
        "depends_on": [
            "modbus_interface"
        ],
        "image_name": "ghcr.io/getdoover/aquamonix-water-meter:main",
        "organisation_id": null,
        "container_registry_profile_id": "93955828574386692",
        "build_args": "--platform linux/amd64,linux/arm64",
        "config_schema": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "$id": "",
            "title": "$default",
            "type": "object",
            "properties": {
                "modbus_id": {
                    "title": "Modbus ID",
                    "x-name": "modbus_id",
                    "x-hidden": false,
                    "type": "integer",
                    "x-required": true,
                    "description": "Modbus ID for the meter",
                    "x-position": 0
                },
                "max_flow": {
                    "title": "Max Flow",
                    "x-name": "max_flow",
                    "x-hidden": false,
                    "type": "integer",
                    "x-required": true,
                    "description": "Max flow value for the meter",
                    "x-position": 1,
                    "exclusiveMinimum": 0
                },
                "allow_shutdown": {
                    "title": "Allow Shutdown",
                    "x-name": "allow_shutdown",
                    "x-hidden": false,
                    "type": [
                        "boolean",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Allow shutdown of the pump",
                    "default": true,
                    "x-position": 2
                },
                "stay_online_seconds": {
                    "title": "Stay Online Seconds",
                    "x-name": "stay_online_seconds",
                    "x-hidden": true,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Time to stay online in seconds",
                    "default": 120,
                    "x-position": 3
                },
                "shutdown_time": {
                    "title": "Shutdown Time",
                    "x-name": "shutdown_time",
                    "x-hidden": true,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Time to stay shutdown in seconds",
                    "default": 900,
                    "x-position": 4
                },
                "dv_app_position": {
                    "title": "Position",
                    "x-name": "dv_app_position",
                    "x-hidden": true,
                    "type": [
                        "integer",
                        "null"
                    ],
                    "x-required": false,
                    "description": "Position of Application in UI Structure. Smaller numbers are closer to the top.",
                    "default": 100,
                    "x-position": 5,
                    "minimum": 0
                },
                "modbus_config": {
                    "title": "Modbus Config",
                    "x-name": "modbus_config",
                    "x-hidden": false,
                    "type": "object",
                    "x-required": true,
                    "x-position": 6,
                    "properties": {
                        "bus_type": {
                            "enum": [
                                "serial",
                                "tcp"
                            ],
                            "title": "Bus Type",
                            "x-name": "bus_type",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "serial",
                            "x-position": 1
                        },
                        "name": {
                            "title": "Name",
                            "x-name": "name",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "default",
                            "x-position": 2
                        },
                        "serial_port": {
                            "title": "Serial Port",
                            "x-name": "serial_port",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "/dev/ttyAMA0",
                            "x-position": 3
                        },
                        "serial_baud": {
                            "title": "Serial Baud",
                            "x-name": "serial_baud",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 9600,
                            "x-position": 4
                        },
                        "serial_method": {
                            "enum": [
                                "rtu",
                                "ascii",
                                "socket",
                                "tls"
                            ],
                            "title": "Serial Method",
                            "x-name": "serial_method",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "rtu",
                            "x-position": 5
                        },
                        "serial_data_bits": {
                            "title": "Serial Data Bits",
                            "x-name": "serial_data_bits",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 8,
                            "x-position": 6
                        },
                        "serial_parity": {
                            "enum": [
                                "None",
                                "Even",
                                "Odd"
                            ],
                            "title": "Serial Parity",
                            "x-name": "serial_parity",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "None",
                            "x-position": 7
                        },
                        "serial_stop_bits": {
                            "title": "Serial Stop Bits",
                            "x-name": "serial_stop_bits",
                            "x-hidden": false,
                            "type": [
                                "integer",
                                "null"
                            ],
                            "x-required": false,
                            "default": 1,
                            "x-position": 8
                        },
                        "serial_timeout": {
                            "title": "Serial Timeout",
                            "x-name": "serial_timeout",
                            "x-hidden": false,
                            "type": [
                                "number",
                                "null"
                            ],
                            "x-required": false,
                            "default": 0.3,
                            "x-position": 9
                        },
                        "tcp_uri": {
                            "title": "TCP URI",
                            "x-name": "tcp_uri",
                            "x-hidden": false,
                            "type": [
                                "string",
                                "null"
                            ],
                            "x-required": false,
                            "default": "127.0.0.1:5000",
                            "x-position": 10
                        },
                        "tcp_timeout": {
                            "title": "TCP Timeout",
                            "x-name": "tcp_timeout",
                            "x-hidden": false,
                            "type": [
                                "number",
                                "null"
                            ],
                            "x-required": false,
                            "default": 2.0,
                            "x-position": 11
                        }
                    },
                    "additionalElements": true,
                    "required": [],
                    "x-collapsible": true,
                    "x-defaultCollapsed": false
                }
            },
            "additionalElements": true,
            "required": [
                "modbus_id",
                "max_flow",
                "modbus_config"
            ]
        },
        "ui_schema": {
            "displayString": "$tag.app().app_display_name:string:\"Aquamonix Water Meter\"",
            "hidden": "$config.app().hidden:boolean:false:boolean:false",
            "position": "$config.app().dv_app_position:number:100",
            "icon": null,
            "colour": null,
            "defaultOpen": "$config.app().dv_app_default_open:boolean",
            "type": "uiApplication",
            "name": "$config.app().APP_KEY",
            "children": {
                "tabs": {
                    "name": "tabs",
                    "type": "uiTabs",
                    "displayString": "Tabs",
                    "showActivity": true,
                    "position": 61,
                    "hidden": false,
                    "children": {
                        "meter": {
                            "name": "meter",
                            "type": "uiContainer",
                            "displayString": "Meter",
                            "showActivity": true,
                            "position": 55,
                            "hidden": false,
                            "children": {
                                "flow": {
                                    "name": "flow",
                                    "type": "uiVariable",
                                    "displayString": "Flow",
                                    "showActivity": true,
                                    "form": "radialGauge",
                                    "position": 51,
                                    "hidden": false,
                                    "units": "ML/day",
                                    "varType": "float",
                                    "currentValue": "$tag.app().last_flow:number:null"
                                },
                                "meter_total": {
                                    "name": "meter_total",
                                    "type": "uiVariable",
                                    "displayString": "Meter Total",
                                    "showActivity": true,
                                    "position": 52,
                                    "hidden": false,
                                    "units": "ML",
                                    "varType": "float",
                                    "currentValue": "$tag.app().last_total:number:null"
                                },
                                "last_read": {
                                    "name": "last_read",
                                    "type": "uiTimestamp",
                                    "displayString": "Last Read",
                                    "showActivity": true,
                                    "position": 53,
                                    "hidden": false,
                                    "varType": "timestamp",
                                    "currentValue": "$tag.app().time_last_update:number:null"
                                },
                                "get_now": {
                                    "name": "get_now",
                                    "type": "uiButton",
                                    "displayString": "Get Now",
                                    "position": 54,
                                    "hidden": false,
                                    "currentValue": "$cmds.app().get_now"
                                }
                            }
                        },
                        "event": {
                            "name": "event",
                            "type": "uiContainer",
                            "displayString": "Event",
                            "showActivity": true,
                            "position": 60,
                            "hidden": false,
                            "children": {
                                "this_event": {
                                    "name": "this_event",
                                    "type": "uiVariable",
                                    "displayString": "This Event",
                                    "showActivity": true,
                                    "position": 56,
                                    "hidden": false,
                                    "units": "ML",
                                    "varType": "float",
                                    "currentValue": "$tag.app().last_event_counter:number:null"
                                },
                                "alert_counter": {
                                    "name": "alert_counter",
                                    "type": "uiFloatInput",
                                    "displayString": "Send Alert At",
                                    "helpString": "Send a notification when event total reaches this value (ML)",
                                    "position": 57,
                                    "hidden": false,
                                    "units": "ML",
                                    "currentValue": "$cmds.app().alert_counter::None",
                                    "default": null,
                                    "min": 0
                                },
                                "shutdown_counter": {
                                    "name": "shutdown_counter",
                                    "type": "uiFloatInput",
                                    "displayString": "Shutdown Pump At",
                                    "helpString": "Stop pumping when event total reaches this value (ML)",
                                    "position": 58,
                                    "hidden": false,
                                    "units": "ML",
                                    "currentValue": "$cmds.app().shutdown_counter::None",
                                    "default": null,
                                    "min": 0
                                },
                                "reset_event": {
                                    "name": "reset_event",
                                    "type": "uiButton",
                                    "displayString": "Reset Event",
                                    "position": 59,
                                    "hidden": false,
                                    "currentValue": "$cmds.app().reset_event",
                                    "requiresConfirm": true
                                }
                            }
                        }
                    }
                },
                "maintenance": {
                    "name": "maintenance",
                    "type": "uiSubmodule",
                    "displayString": "Maintenance",
                    "showActivity": true,
                    "position": 65,
                    "hidden": false,
                    "children": {
                        "battery": {
                            "name": "battery",
                            "type": "uiVariable",
                            "displayString": "Battery",
                            "showActivity": true,
                            "position": 62,
                            "hidden": false,
                            "units": "V",
                            "varType": "float",
                            "currentValue": "$tag.app().last_batt_volts:number:null",
                            "decPrecision": 1,
                            "ranges": [
                                {
                                    "min": 11.5,
                                    "max": 12.3,
                                    "colour": "yellow",
                                    "show_on_graph": true,
                                    "label": "Low"
                                },
                                {
                                    "min": 12.3,
                                    "max": 13.0,
                                    "colour": "blue",
                                    "show_on_graph": true,
                                    "label": "Good"
                                },
                                {
                                    "min": 13.0,
                                    "max": 14.0,
                                    "colour": "green",
                                    "show_on_graph": true,
                                    "label": "Charging"
                                },
                                {
                                    "min": 14.0,
                                    "max": 14.5,
                                    "colour": "red",
                                    "show_on_graph": true,
                                    "label": "OverCharging"
                                }
                            ]
                        },
                        "solar": {
                            "name": "solar",
                            "type": "uiVariable",
                            "displayString": "Solar",
                            "showActivity": true,
                            "position": 63,
                            "hidden": false,
                            "units": "V",
                            "varType": "float",
                            "currentValue": "$tag.app().last_solar_volts:number:null",
                            "decPrecision": 1,
                            "ranges": [
                                {
                                    "min": 0,
                                    "max": 14.0,
                                    "colour": "blue",
                                    "show_on_graph": true,
                                    "label": "Low"
                                },
                                {
                                    "min": 14.0,
                                    "max": 25,
                                    "colour": "green",
                                    "show_on_graph": true,
                                    "label": "Charging"
                                }
                            ]
                        },
                        "comms_active": {
                            "name": "comms_active",
                            "type": "uiVariable",
                            "displayString": "Comms Active",
                            "showActivity": true,
                            "position": 64,
                            "hidden": false,
                            "varType": "bool",
                            "currentValue": "$tag.app().comms_active:boolean:false"
                        }
                    },
                    "defaultOpen": false
                }
            }
        }
    }
}